{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "jsxImportSource": "solid-js",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["src/app/**/*", "tests/**/*", "src/plugin.ts", "vite.config.ts"]
}
